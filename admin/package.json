{
  "name": "@datacatalog/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3001 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3001 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "api:generate": "openapi-typescript ../server/target/openapi.json -o src/lib/generated/api.d.ts"
  },
  "dependencies": { "react": "19.3.1", "react-dom": "19.3.1" },
  "devDependencies": {
    "@eslint/js": "10.0.1", "@types/node": "22.18.6", "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0", "@vitejs/plugin-react": "6.1.2", "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1", "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0", "openapi-typescript": "7.13.0", "typescript": "5.9.3",
    "typescript-eslint": "8.71.2", "vite": "8.3.4"
  }
}
