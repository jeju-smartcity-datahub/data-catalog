<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.egovframe.boot</groupId>
    <artifactId>egovframe-boot-starter-parent</artifactId>
    <version>5.0.1</version>
    <relativePath/>
  </parent>
  <groupId>kr.co.dtonic</groupId>
  <artifactId>datacatalog-server</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Data Catalog Server</name>
  <description>Data catalog REST API and PostgreSQL persistence</description>
  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <springdoc.version>2.8.13</springdoc.version>
    <testcontainers.version>1.21.4</testcontainers.version>
    <!-- Keep the eGovFrame parent and runtime versions compatible with Spring Boot. -->
    <catalog.spring-boot.version>3.5.16</catalog.spring-boot.version>
    <!-- eGov and Boot use different property names for these BOMs. Keep both aligned. -->
    <spring.framework.version>6.2.19</spring.framework.version>
    <spring-framework.version>6.2.19</spring-framework.version>
    <spring.security.version>6.5.11</spring.security.version>
    <spring-security.version>6.5.11</spring-security.version>
    <tomcat.version>10.1.60</tomcat.version>
    <log4j2.version>2.25.5</log4j2.version>
    <micrometer.version>1.15.12</micrometer.version>
    <micrometer-tracing.version>1.5.12</micrometer-tracing.version>
    <postgresql.version>42.7.14</postgresql.version>
    <jackson-bom.version>2.21.7</jackson-bom.version>
    <catalog.httpclient5.version>5.6.3</catalog.httpclient5.version>
    <catalog.httpcore5.version>5.4.3</catalog.httpcore5.version>
  </properties>
  <repositories>
    <!-- Official Central endpoint; TLS verification remains enabled. -->
    <repository><id>central</id><url>https://repo1.maven.org/maven2</url></repository>
    <repository><id>egovframe</id><url>https://maven.egovframe.go.kr/maven/</url><snapshots><enabled>false</enabled></snapshots></repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository><id>central</id><url>https://repo1.maven.org/maven2</url></pluginRepository>
  </pluginRepositories>
  <dependencyManagement>
    <dependencies>
      <!-- Keep the HTTP parser security fixes even when the inherited Boot BOM manages older Core versions. -->
      <dependency><groupId>org.apache.httpcomponents.core5</groupId><artifactId>httpcore5</artifactId><version>${catalog.httpcore5.version}</version></dependency>
      <dependency><groupId>org.apache.httpcomponents.core5</groupId><artifactId>httpcore5-h2</artifactId><version>${catalog.httpcore5.version}</version></dependency>
      <!-- Imported BOM properties are resolved in their own model. Put patched family BOMs
           before Boot's BOM so its default Jackson/Log4j versions cannot win the import order. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId><artifactId>jackson-bom</artifactId><version>${jackson-bom.version}</version>
        <type>pom</type><scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId><artifactId>log4j-bom</artifactId><version>${log4j2.version}</version>
        <type>pom</type><scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId><artifactId>spring-boot-dependencies</artifactId><version>${catalog.spring-boot.version}</version>
        <type>pom</type><scope>import</scope>
      </dependency>
      <!-- Explicit runtime/test Boot entries override versions inherited from the eGov parent.
           Importing a child BOM alone must not leave inherited Boot 3.5.6 entries in use. -->
      <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot</artifactId><version>${catalog.spring-boot.version}</version></dependency>
      <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-autoconfigure</artifactId><version>${catalog.spring-boot.version}</version></dependency>
      <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-actuator</artifactId><version>${catalog.spring-boot.version}</version></dependency>
      <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-actuator-autoconfigure</artifactId><version>${catalog.spring-boot.version}</version></dependency>
      <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-jarmode-tools</artifactId><version>${catalog.spring-boot.version}</version></dependency>
      <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId><version>${catalog.spring-boot.version}</version></dependency>
      <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-json</artifactId><version>${catalog.spring-boot.version}</version></dependency>
      <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-tomcat</artifactId><version>${catalog.spring-boot.version}</version></dependency>
      <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-log4j2</artifactId><version>${catalog.spring-boot.version}</version></dependency>
      <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId><version>${catalog.spring-boot.version}</version></dependency>
      <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId><version>${catalog.spring-boot.version}</version></dependency>
      <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId><version>${catalog.spring-boot.version}</version></dependency>
      <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId><version>${catalog.spring-boot.version}</version></dependency>
      <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><version>${catalog.spring-boot.version}</version></dependency>
      <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-test</artifactId><version>${catalog.spring-boot.version}</version></dependency>
      <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-test-autoconfigure</artifactId><version>${catalog.spring-boot.version}</version></dependency>
      <!-- Every Boot starter uses the same Log4j2 binding as eGov RTE. -->
      <dependency>
        <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter</artifactId><version>${catalog.spring-boot.version}</version>
        <exclusions><exclusion><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-logging</artifactId></exclusion></exclusions>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency><groupId>org.egovframe.rte</groupId><artifactId>egovframe-rte-fdl-cmmn</artifactId></dependency>
    <dependency><groupId>org.egovframe.rte</groupId><artifactId>egovframe-rte-psl-dataaccess</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-log4j2</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>org.apache.httpcomponents.client5</groupId><artifactId>httpclient5</artifactId><version>${catalog.httpclient5.version}</version></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
    <dependency><groupId>org.springdoc</groupId><artifactId>springdoc-openapi-starter-webmvc-api</artifactId><version>${springdoc.version}</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>postgresql</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><version>${catalog.spring-boot.version}</version><configuration><mainClass>kr.co.dtonic.datacatalog.DataCatalogApplication</mainClass></configuration></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><configuration><excludedGroups>postgres</excludedGroups></configuration></plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
        <configuration><groups>postgres</groups><includes><include>**/*IT.java</include></includes><failIfNoTests>true</failIfNoTests></configuration>
        <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
